  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "../.site-build",
    "rootDir": "."
  },
  "include": [
    "app.ts",
    "submission-identity.ts",
    "recommender.ts",

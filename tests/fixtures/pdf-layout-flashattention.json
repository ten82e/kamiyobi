        "width": 7.5708336384,
        "height": 8.9664
      },
      {
        "str": " ",
        "transform": [9.145728, 0, 0, 8.9664, 104.4778336384, 391.621],
        "width": 4.49820231529412,
        "height": 0
      },
      {
        "str": "FlashAttention",
        "transform": [9.145728, 0, 0, 8.9664, 109.066, 391.621],
        "width": 75.39372334080002,
        "height": 8.9664
      },
      {
        "str": ", showing that it requires fewer HBM accesses than standard attention, and is",
        "transform": [9.145728, 0, 0, 8.9664, 184.462, 391.621],
        "width": 330.6299566463996,
        "height": 8.9664
      },
      {

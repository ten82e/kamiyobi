<script>
  // scrollspy - exactly one active link: the first visible section in document order
  (function(){
    var map = {};
    document.querySelectorAll('.sidebar nav a').forEach(function(a){
      map[a.getAttribute('href').slice(1)] = a;
    });
    var sections = Array.prototype.slice.call(document.querySelectorAll('section[id]'));
    var visible = {}, current = null;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ visible[e.target.id] = e.isIntersecting; });
      var first = null;
      for(var i=0;i<sections.length;i++){ if(visible[sections[i].id]){ first = sections[i].id; break; } }
      if(first === current) return;              // nothing changed - skip the DOM writes
      if(map[current]) map[current].classList.remove('active');
      current = first;
      if(map[current]) map[current].classList.add('active');
    },{rootMargin:'-25% 0px -60% 0px'});
    sections.forEach(function(s){ io.observe(s); });
  })();

  // placeholder links (href="#") - no jump-to-top, just drop focus
  document.querySelectorAll('a[href="#"]').forEach(function(a){
    if(a.classList.contains('brand-mini')) return;
    a.addEventListener('click', function(e){
      e.preventDefault();
      a.blur();
    });
  });

  // Reveal-on-enter, once. IntersectionObserver only - no scroll listeners.
  // The hidden state is gated on .js-reveal, which is set here and only here, so
  // reduced-motion, no-JS, and browsers without IO all render the content plainly.
  (function(){
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('.reveal');
    if(!els.length || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('js-reveal');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);       // once
      });
    },{rootMargin:'0px 0px -12% 0px', threshold:0.15});
    els.forEach(function(el){ io.observe(el); });

    // Safety net: nothing stays invisible. If an element never trips the observer
    // (print, find-in-page, hash link past it), reveal whatever is left.
    window.addEventListener('load', function(){
      setTimeout(function(){
        els.forEach(function(el){
          if(!el.classList.contains('in') && el.getBoundingClientRect().top < window.innerHeight){
            el.classList.add('in');
          }
        });
      }, 1200);
    });
  })();

  // Topic disclosures: hover previews, click pins. Only where a real pointer
  // exists - on touch and for keyboard users the native click/Enter toggle is
  // left completely alone, so the content is never hover-only.
  (function(){
    if(!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    document.querySelectorAll('.eg-toggle').forEach(function(d){
      var summary = d.querySelector('summary');
      var timer = null;
      // The .pinned class is the only state. Keeping a parallel closure flag
      // lets the two drift whenever something toggles `open` from outside -
      // find-in-page expanding a match, say - and the control then sticks.
      var isPinned = function(){ return d.classList.contains('pinned'); };

      summary.addEventListener('click', function(e){
        if(d.open && !isPinned()){          // opened by hover: clicking pins it
          e.preventDefault();
          d.classList.add('pinned');
          return;
        }
        d.classList.toggle('pinned', !d.open);   // otherwise a plain toggle
      });

      d.addEventListener('mouseenter', function(){
        clearTimeout(timer);
        if(!isPinned()) d.open = true;
      });
      d.addEventListener('mouseleave', function(){
        clearTimeout(timer);
        if(isPinned()) return;
        timer = setTimeout(function(){
          if(!isPinned()) d.open = false;   // re-check: state may have changed
        }, 140);
      });
    });
  })();

  // NewsLLM disclosure: the control remains at the end while the copy contracts,
  // and the viewport follows the disclosure's stable top edge back up the page.
  (function(){
    var details = document.querySelector('.newsllm-more');
    if(!details) return;
    var summary = details.querySelector('summary');
    var content = details.querySelector('.newsllm-more-content');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var duration = 520;

    summary.addEventListener('click', function(e){
      if(reduceMotion.matches || details.classList.contains('is-animating')) return;
      e.preventDefault();
      details.classList.add('is-animating');

      if(!details.open){
        details.classList.add('is-opening');
        details.open = true;
        content.getBoundingClientRect();
        requestAnimationFrame(function(){
          details.classList.remove('is-opening');
          window.setTimeout(function(){ details.classList.remove('is-animating'); }, duration);
        });
        return;
      }

      var anchorTop = summary.getBoundingClientRect().top;
      var startedAt = performance.now();
      details.classList.add('is-closing');
      document.documentElement.classList.add('newsllm-collapsing');

      // Keep the bottom control visually anchored while the copy above it gets
      // shorter. The equal-and-opposite scroll makes the page travel upward with
      // the collapsing content instead of jumping to the following section.
      var followCollapse = function(now){
        var movement = summary.getBoundingClientRect().top - anchorTop;
        if(Math.abs(movement) > .25) window.scrollBy(0, movement);
        if(now - startedAt < duration + 80) requestAnimationFrame(followCollapse);
      };
      requestAnimationFrame(followCollapse);

      window.setTimeout(function(){
        details.open = false;
        details.classList.remove('is-closing','is-animating');
        document.documentElement.classList.remove('newsllm-collapsing');
        summary.focus({preventScroll:true});
      }, duration);
    });
  })();

  // mobile drawer nav
  (function(){
    var btn = document.querySelector('.menu-btn');
    var sidebar = document.querySelector('.sidebar');
    var overlay = document.querySelector('.nav-overlay');
    if(!btn || !sidebar || !overlay) return;

    function open(){
      sidebar.classList.add('open');
      overlay.classList.add('open');
      btn.setAttribute('aria-expanded','true');
      btn.setAttribute('aria-label','Close menu');
      document.body.style.overflow = 'hidden';
    }
    function close(){
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      btn.setAttribute('aria-expanded','false');
      btn.setAttribute('aria-label','Open menu');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', function(){
      sidebar.classList.contains('open') ? close() : open();
    });

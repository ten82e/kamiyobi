<div x-data="consentBanner" x-cloak x-show="show"
    style="display: none;"
    data-consent-revoke-before=""
    data-consent-has-revoke-date="false"
    data-use-ea="true"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 transform translate-y-2"
    x-transition:enter-end="opacity-100 transform translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 transform translate-y-0"
    x-transition:leave-end="opacity-0 transform translate-y-2"
    class="fixed
        
        bottom-0
        
        
        left-0 right-0 z-50"
    role="dialog" aria-labelledby="consent-banner-title" aria-modal="true">
    <div class="max-w-screen-xl mx-auto p-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <div class="space-y-4">
                <div class="flex justify-between items-start">
                    <h2 id="consent-banner-title" class="text-lg font-semibold text-gray-900 dark:text-white">
                        Privacy Notice
                    </h2>
                    <button x-on:click="show = false"
                        class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300"
                        aria-label="Close consent banner">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <p class="text-gray-600 dark:text-gray-300 text-sm">
                    When you visit websites, they may store or retrieve data about you using cookies and similar technologies ("cookies"). Cookies may be necessary for the basic functionality of the website as well as other purposes. You have the option of disabling certain types of cookies, though doing so may impact your experience on the website.
                    
                </p>

                <div class="flex flex-wrap gap-3 justify-end" role="group" aria-labelledby="consent-banner-title">
                    <button @click="$store.consentBanner.rejectAll()" type="button"
                        class="inline-flex items-center gap-0.5 font-bold motion-safe:transition decoration-transparent decoration-dotted hover:decoration-2 focus:decoration-2 rounded-full hover:decoration-primary focus:decoration-primary focus:outline-none text-sm px-4 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
                        aria-label="Decline Tracking">
                        Decline
                    </button>

                    <button type="button" x-on:click="toggleSettings"
                        class="inline-flex items-center gap-0.5 font-bold motion-safe:transition decoration-transparent decoration-dotted hover:decoration-2 focus:decoration-2 rounded-full hover:decoration-primary focus:decoration-primary focus:outline-none text-sm px-4 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
                        :aria-expanded="showSettings ? 'true' : 'false'"
                        aria-controls="cookie-settings-panel"
                        aria-label="Show Settings">
                        Customize
                    </button>

                    <button @click="$store.consentBanner.acceptAll()" type="button"
                        class="inline-flex items-center gap-0.5 font-bold motion-safe:transition
                        max-w-full pb-2 pt-2.5 px-4 rounded-3xl leading-none no-underline select-none whitespace-nowrap
                        bg-primary text-xs text-wider text-white uppercase focus:outline-primary hover:outline-primary"
                        aria-label="Accept Tracking">
                        Accept
                    </button>
                </div>

                <div id="cookie-settings-panel" x-show="showSettings" x-transition
                    class="mt-4 p-4 bg-gray-50 dark:bg-gray-700 rounded-lg"
                    aria-labelledby="cookie-settings-heading" role="region">
                    <h3 id="cookie-settings-heading" class="sr-only">Cookie Settings</h3>
                    <div class="space-y-4">
                        <template x-for="type in $store.consentBanner.getConsentTypes()">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                    <span class="block font-medium text-gray-900 dark:text-white text-sm" x-text="type.title"></span>
                                    <span class="block text-sm text-gray-500 dark:text-gray-400 mt-0.5" x-text="type.explanation"></span>

                                    <div x-show="type.services && type.services.length" x-data="{ expanded: false }" class="mt-1 text-xs">
                                        <button type="button" @click="expanded = !expanded"
                                            class="inline underline text-primary">More information</button>
                                        <ul x-show="expanded" x-collapse class="list-disc list-inside mt-1">
                                            <template x-for="service in type.services">
                                                <li x-text="service"></li>
                                            </template>
                                        </ul>
                                    </div>
                                </div>

                                <div class="relative shrink-0 mt-0.5">
                                    <input type="checkbox" :id="'consent-' + type.handle"
                                        :checked="type.value"
                                        :disabled="type.disabled"
                                        @change="if (!type.disabled) type.value = $event.target.checked"
                                        class="sr-only peer"
                                        :aria-label="type.title">
                                    <div :class="type.disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'"
                                        @click="if (!type.disabled) type.value = !type.value"
                                        class="w-11 h-6 bg-gray-200 border border-gray-300 rounded-full peer dark:bg-gray-700 dark:border-gray-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary peer-checked:border-primary"
                                        aria-hidden="true"></div>
                                </div>
                            </div>
                        </template>

                        <div class="flex justify-end pt-2">
                            <button @click="$store.consentBanner.saveConsent()" type="button"
                                class="inline-flex items-center gap-0.5 font-bold motion-safe:transition
                                max-w-full pb-2 pt-2.5 px-4 rounded-3xl leading-none no-underline select-none whitespace-nowrap
                                bg-primary text-xs text-wider text-white uppercase focus:outline-primary hover:outline-primary">
                                Accept selected
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    

    <script>
    let consentData = {
        "consent": false,
        "date": null,
        "consent_api": false,
        "custom_scripts": true,
        "types": [
            {
                "value": true,
                "handle": "functionalCookies",
                "title": "Functional",
                "explanation": "Functional cookies are needed for the website to work correctly.",
                "disabled": true
            },
            
            
            
                
                    
                        {
                            "value": true,
                            "handle": "customScript1",
                            "title": "LinkedIn Insight Tag",
                            "explanation": "LinkedIn Insight Tag is a lightweight JavaScript code snippet that you can add to your website to enable advanced campaign reporting, track conversions, retarget website visitors, and gain demographic insights about your audience.",
                            
                            "script_fragments": [
                                
                                    {
                                        "category": "customScript1",
                                        "type": "inline_script",
                                        "defer": false,
                                        "async": false,
                                        "attributes": [
                                            
                                        ],
                                        "source": "",
                                        "inline_script": "_linkedin_partner_id = \"8726042\"; window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || []; window._linkedin_data_partner_ids.push(_linkedin_partner_id); <\/script><script type=\"text/javascript\"> (function(l) { if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])}; window.lintrk.q=[]} var s = document.getElementsByTagName(\"script\")[0]; var b = document.createElement(\"script\"); b.type = \"text/javascript\";b.async = true; b.src = \"https://snap.licdn.com/li.lms-analytics/insight.min.js\"; s.parentNode.insertBefore(b, s);})(window.lintrk);"
                                    },
                                
                            ]
                        },
                    
                
            
            
            
                {
                    "value": true,
                    "handle": "geolocation",
                    "title": "Geolocation Tracking",
                    "explanation": "Track visitor locations for better insights."
                },
            
                {
                    "value": true,
                    "handle": "targetedadvertising",
                    "title": "Targeted Advertising",
                    "explanation": "Used to deliver advertising that is more relevant to you and your interests. May also be used to limit the number of times you see an advertisement and measure the effectiveness of advertising campaigns. Advertising networks usually place them with the website operator\&#039;s permission."
                },
            
                {
                    "value": true,
                    "handle": "personalization",
                    "title": "Personalization",
                    "explanation": "Allow the website to remember choices you make (such as your username, language, or the region you are in) and provide enhanced, more personal features. For example, a website may provide you with local weather reports or traffic news by storing data about your general location."
                },
            
                {
                    "value": true,
                    "handle": "analytics",
                    "title": "Analytics",
                    "explanation": "Help the website operator understand how its website performs, how visitors interact with the site, and whether there may be technical issues.",
                    "services": [
                        
                            "Built-in Analytics",
                        
                    ]
                },
            
                {
                    "value": false,
                    "handle": "donotsell",
                    "title": "Do Not Sell or Share My Personal Information",
                    "explanation": "By switching the toggle to the right and clicking save, you are indicating that you do not want us to sell your personal information or share your personal information for online targeted advertising activities. Please note if you use different computers or browsers, you must indicate your choices again on each computer or browser used to access our services."
                },
            
        ]
    }
</script>


    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.store('consentBanner', {
                data: Alpine.$persist(consentData).as('consentBannerDac26'),
                acceptAll() {
                    this.data.types.forEach((type) => type.value = true)
                    this.saveConsent()
                },
                accept(handle) {
                    this.data.types.filter((type) => {
                        return type['handle'] === handle
                    }).forEach((type) => type.value = true)
                    this.saveConsent()
                },
                getConsent() {
                    return this.data.consent
                },
                getConsentAPIValues() {
                    return this.data.types.filter((type) => {
                        return type['consent_api'] === true
                    }).reduce((acc, type) => {
                        acc[type.consent_api_handle] = type.value ? 'granted' : 'denied';
                        return acc;
                    }, {});
                },
                getCustomScripts() {
                    return this.data.types.filter((type) => type.hasOwnProperty('script_fragments') && type.value);
                },
                getConsentDate() {
                    return this.data.date
                },
                getConsentTypes() {
                    return this.data.types
                },
                getConsentValue(handle) {
                    return this.data.types.filter((type) => {
                        return type['handle'] === handle
                    })[0]['value']
                },
                invalidate() {
                    this.data = consentData
                },
                rejectAll() {
                    this.data.types.forEach((type) => type.value = false)
                    this.saveConsent()
                },
                revokeConsent() {
                    this.data.consent = false
                    this.data.date = null
                    localStorage.removeItem('analytics_consent')
                    localStorage.removeItem('analytics_settings')
                },
                saveConsent() {
                    this.data.consent = true
                    this.data.date = Math.floor(Date.now() / 1000)
                    this._syncEAConsent()
                },
                _useEA: true,
                _syncEAConsent() {
                    if (!this._useEA) {
                        localStorage.removeItem('analytics_consent')
                        localStorage.removeItem('analytics_settings')
                        return
                    }
                    const analyticsType = this.data.types.find(t => t.handle === 'analytics')
                    const geoType = this.data.types.find(t => t.handle === 'geolocation')
                    const accepted = analyticsType ? analyticsType.value : false
                    const settings = { geolocation: geoType ? geoType.value : false }
                    localStorage.setItem('analytics_consent', accepted ? 'accepted' : 'declined')
                    localStorage.setItem('analytics_settings', JSON.stringify(settings))
                    const csrf = document.querySelector('meta[name="csrf-token"]')
                    if (csrf) {
                        fetch('/enhanced-analytics/consent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf.getAttribute('content') },
                            body: JSON.stringify({ consent: accepted, settings: settings })
                        }).catch(err => console.error('EA consent sync error:', err))
                    }
                    window.dispatchEvent(new CustomEvent('analytics-consent-changed', { detail: { consent: accepted, settings: settings } }))
                },
                useConsentAPI() {
                    return this.data.consent_api
                },
                useCustomScripts() {
                    return this.data.custom_scripts
                },
                useEmbeds() {
                    return this.data.embeds
                }
            })

            Alpine.data('consentBanner', () => ({
                show: !Alpine.store('consentBanner').getConsent(),
                showSettings: false,
                init() {
                    const el = this.$el
                    const hasRevokeDate = el.dataset.consentHasRevokeDate === 'true'
                    const revokeDate = el.dataset.consentRevokeBefore
                    if (hasRevokeDate && Alpine.store('consentBanner').getConsentDate() < revokeDate) {
                        Alpine.store('consentBanner').invalidate()
                    }
                    Alpine.store('consentBanner')._useEA = el.dataset.useEa === 'true'
                    if (Alpine.store('consentBanner').getConsent() && !localStorage.getItem('analytics_consent')) {
                        Alpine.store('consentBanner')._syncEAConsent()
                    }
                    if (Alpine.store('consentBanner').useConsentAPI() && Alpine.store('consentBanner').getConsent()) {
                        gtag('consent', 'update', Alpine.store('consentBanner').getConsentAPIValues())
                    }
                    if (Alpine.store('consentBanner').useConsentAPI()) {
                        this.$watch('$store.consentBanner.data.consent', value => value && gtag('consent', 'update', Alpine.store('consentBanner').getConsentAPIValues()))
                    }
                    if (Alpine.store('consentBanner').useCustomScripts() && Alpine.store('consentBanner').getConsent()) {
                        this.runCustomScripts()
                    }
                    if (Alpine.store('consentBanner').useCustomScripts()) {
                        this.$watch('$store.consentBanner.data.consent', value => value ? this.runCustomScripts() : this.removeCustomScripts())
                    }
                    this.$watch('$store.consentBanner.data.consent', value => { this.show = !value })
                },
                toggleSettings() {
                    this.showSettings = !this.showSettings
                },
                runCustomScripts() {
                    Alpine.store('consentBanner')
                        .getCustomScripts()
                        .flatMap(script => script.script_fragments)
                        .forEach(script => {
                            const tag = document.createElement('script')
                            script.type === 'script_tag'
                                ? tag.src = script.source
                                : tag.text = script.inline_script.replace(/<\/script>\s*<script[^>]*>/gi, '\n')
                            tag.defer = script.defer
                            tag.async = script.async
                            script.attributes.forEach(attribute => tag.setAttribute(attribute.key, attribute.value))
                            document.head.appendChild(tag)
                            this.$el.addEventListener(`remove-custom-scripts-${script.category}`, () => tag.remove(), { once: true })
                        })
                },
                removeCustomScripts() {
                    Alpine.store('consentBanner')
                        .getCustomScripts()
                        .forEach(script => this.$dispatch(`remove-custom-scripts-${script.handle}`))
                }
            }))
        })
    </script>
</div>

            <div class="relative flex items-center" x-data="navFlyout()">
                <button type="button"
                    class="font-bold leading-tight tracking-tighter normal-case text-sm inline-flex items-center text-primary"
                     :aria-expanded="subnavOpen"
                    @click.prevent="toggle()" aria-label="Exhibition"
                    aria-haspopup="true">
                    
                    <span class="link-toright before:!bg-base-content">Exhibition</span>
                     
                    <span
                        class="inline-block ml-0.5 -mt-0.5 size-4 transition-transform duration-500 opacity-50"
                        :class="{ 'rotate-180': subnavOpen }">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </button>
                
                <div x-cloak x-show="subnavOpen"
                    x-ref="flyout"
                    class="absolute z-10 top-[2.55rem] min-w-140"
                    :style="flyoutStyle"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 translate-y-1"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-y-0"
                    x-transition:leave-end="opacity-0 translate-y-1"
                    @click.outside="subnavOpen = false" role="menu">
                    <div
                        class="bg-base-100 flex-auto border-t-4 border-base-content rounded-b-xl text-sm leading-6 shadow-md ring-1 ring-gray-900/5 relative after:absolute after:top-0 after:left-1/2 after:translate-x-0 after:-translate-y-full after:z-10 after:content-[''] after:w-0 after:h-0 after:border-l-[17px] after:border-l-transparent after:border-r-[17px] after:border-r-transparent after:border-b-[14px] after:border-b-base-content w-full">
                        <div
                            class="w-full inline-grid grid-cols-1 gap-x-2 gap-y-1 p-2 xl:grid-cols-2"
                        >
                            

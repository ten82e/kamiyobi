/* bluesky social icon */
.fa-globe:before {
    content: "";
}

.fa-globe {
    width: 100%;
    height: 100%;
    background-image: url("http://eg2027.isti.cnr.it/wp-content/uploads/2026/06/Bluesky_Logo.png");
    background-size: 100%;
    background-repeat: no-repeat;
    background-position: center;
}

a[href*="bsky.app"].shape-circle {
    width: 30px;
    height: 30px;
    background-color: #ffffff;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15); /* stesso stile tipico */
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* hero video background */
.elementor-background-video-container {
    background-color: #000;
}

/* menu */
.menu-item-has-children > a {
    cursor: default;
}


.elementor-widget-text-editor {
    white-space: normal;
    overflow-wrap: break-word;
}


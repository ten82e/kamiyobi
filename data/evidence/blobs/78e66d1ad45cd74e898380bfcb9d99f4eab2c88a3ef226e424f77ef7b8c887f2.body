<script src="/js/easy.js?version=545"></script><script src="/js/menu.js?version=545"></script><script src="/js/form.js?version=545"></script><script src="/js/inplace.js?version=545"></script><script>EC.version='545'</script></head>
<body><table class="page" id="page"><tr style="height:1px"><td><table class="header"><tr><td class="logocell"><a href="/" title="EasyChair home page"><img class="leftlogo" src="/images/logoEC_short.png"/></a></td><td class="rolecell">EasyChair Smart CFP</td><td style="width: 99%"></td><td class="helplink"><a class="toplinks" href="/docs/home" title="User guide">User guide</a></td></tr></table></td></tr><tr style="height:99%"><td class="menu_and_content"><div class="menu" id="menu0"><table cellpadding="0" cellspacing="0" class="menu" style="position:static; visibility:visible"><tr><td class="top" id="menu1" onclick="Menu.followLink2('menu1','/cfp',{&quot;a&quot;:null})" onmouseout="Menu.hide('menu1')" onmouseover="Menu.show('menu1')" title="Main page">Home</td><td class="top" id="menu2" onclick="Menu.followLink2('menu2','/cfp/choose',{})" onmouseout="Menu.hide('menu2')" onmouseover="Menu.show('menu2')" title="Create a new CFP">New CFP</td><td class="top" id="menu3" onclick="Menu.followLink2('menu3','/cfp/all',{})" onmouseout="Menu.hide('menu3')" onmouseover="Menu.show('menu3')" title="Manage my CFPs">My CFPs</td><td class="top" id="menu4" onclick="Menu.followLink2('menu4','/cfp/watchlist',{})" onmouseout="Menu.hide('menu4')" onmouseover="Menu.show('menu4')" title="My CFP watchlist">Watchlist</td></tr></table></div><div class="search_row" id="cfp:search:row"><form action="/cfp/search" id="search-form"><input id="search-input" name="query" placeholder="Search" type="text"/></form></div><div class="summary"><div class="pagetitle">CFP</div></div><div class="content" id="content"><div class="subcontent"><div id="cfp" style="clear:right"><table class="title_table"><tr><td class="logocell"><img src="/images/cfp-logo/PAKDD2027.jpg?id=429478013"/></td><td class="titlecell"><div id="cfptitle">PAKDD2027: The 31st Pacific-Asia Conference on Knowledge Discovery and Data Mining</div><div id="cfpvenue"></div><div id="cfpdateplace">Wellington, New Zealand, June 29-July 2, 2027</div></td></tr></table><table class="date_table"><tr><td>Conference web page</td><td><a href="https://www.pakdd2027.org/" target="_blank">https://www.pakdd2027.org/</a></td></tr><tr><td>Submission deadline</td><td>November 20, 2026</td></tr></table><div class="topics">Topics: <a href="/cfp/topic?tid=2179" onclick="return EC.linkClick(event)"><span class="tag fg_black bg_darksalmon">data mining</span></a> <a href="/cfp/topic?tid=1384" onclick="return EC.linkClick(event)"><span class="tag fg_black bg_palegoldenrod">knowledge discovery</span></a> <a href="/cfp/topic?tid=401" onclick="return EC.linkClick(event)"><span class="tag fg_navy bg_darkyellow">machine learning</span></a> <a href="/cfp/topic?tid=1344508" onclick="return EC.linkClick(event)"><span class="tag fg_black bg_green">data science</span></a></div><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-size:14px"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">The Pacific-Asia Conference on Knowledge Discovery and Data Mining (PAKDD) is a leading international conference with a long-standing tradition in data mining, knowledge discovery, machine learning, and data science. The conference provides an international peer-reviewed forum for presenting original research, exchanging innovative ideas, and discussing emerging challenges and applications.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-size:14px"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Hosted in </span></span></span><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Wellington, New Zealand, from 29 June to 2 July 2027</span></span></strong><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">, PAKDD 2027 continues this tradition with an engaging programme of keynote presentations, peer-reviewed research papers, workshops, tutorials, and a doctoral consortium. As a well-regarded conference with a strong research community, PAKDD brings together leading researchers and practitioners through invited talks and high-quality refereed research papers.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-size:14px"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">We invite high-quality submissions across four tracks, covering theoretical advances, novel methodologies, and practical applications of data science.</span></span></span></span></span></span></span><span style="display:none"> </span></p><h2>Submission Tracks</h2><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">PAKDD 2027 welcomes submissions across four tracks:</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">1. Research Track: </span></span></strong></span></span></span></span><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Novel, original, and high-quality research in knowledge discovery, data mining, machine learning, and data science, spanning theoretical foundations, learning methods, big data, trustworthy AI, security and privacy, emerging topics, and interdisciplinary applications.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">2. Survey Track: </span></span></strong></span></span></span></span><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Surveys, systematic reviews, comparative studies, and vision papers that synthesise existing research, develop new taxonomies and frameworks, critically assess methods and benchmarks, and identify emerging directions and open challenges in data science.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">3. Special Track: LLM and Agentic AI in Data Science: </span></span></strong></span></span></span></span><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Innovative research on LLMs and Agentic AI for data science and knowledge discovery, covering data preparation, knowledge extraction, retrieval-augmented generation, autonomous agents, and reliable, secure, and responsible use.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">4. Applied Data Science Track: </span></span></strong></span></span></span></span><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Real-world data science research addressing practical challenges and domain needs, with a focus on sound methodology, realistic evaluation, and impact, including deployed systems, pilots, case studies, and rigorous evaluations.</span></span></span></span></span></span></span></p><h2>Topics of Interest</h2><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">We welcome submissions covering a broad range of topics, including, but not limited to:</span></span></span></span></span></span></span></p><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Data Mining and Knowledge Discovery</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Machine Learning and Deep Learning</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Clustering, Classification, and Pattern Mining</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Generative AI and Foundation Models</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Large Language Models and Agentic AI</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Representation Learning, Transfer Learning, and Generalisation</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Data-Centric AI and Data Preparation</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Supervised Learning, Semi-Supervised Learning, Few-Shot and Zero-Shot Learning, Active Learning</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Reinforcement Learning and Recommender Systems</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Learning on Structured Data, Graphs, and Multi-Modal Data</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Causal Learning and Inference</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Anomaly Detection</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Learning in Streams and Time Series</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Information Retrieval, Knowledge Extraction, and Big Data Technologies</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Explainable, Fair, Trustworthy, and Responsible AI</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Privacy-Preserving and Federated Learning</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Interdisciplinary Research on Data Science Applications</span></span></span></span></span></span></span></li></ul><p style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><strong style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">For a more comprehensive list of topics covered by all four tracks, please visit: </span></span></strong></span></span><a href="https://www.pakdd2027.org/pages/calls/research" style="text-decoration:none"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#467886"><strong style="font-weight:700"><span style="font-style:normal"><u style="text-decoration:underline"><span style="text-decoration-skip-ink:none">https://www.pakdd2027.org/pages/calls/research</span></u></span></strong></span></span></a></span></span></p><h2>Submission and Publication</h2><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Accepted papers will be presented at PAKDD 2027 in Wellington, New Zealand. At least one author of each accepted paper must register for and attend the conference to present the paper.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">All submitted papers must follow the Springer LNCS/LNAI format and will undergo double-blind peer review. Accepted papers will be published in Springer’s Lecture Notes in Artificial Intelligence (LNAI) series.</span></span></span></span></span></span></span></p><p style="line-height:1.3900000000000001; margin-bottom:11px"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">For submission guidelines and track-specific requirements, please visit: <a href="https://pakdd2027.org/pages/calls/authors-kit">https://pakdd2027.org/pages/calls/authors-kit </a></span></span></span></span></span></span></span></p><h2>Committees</h2><h3 style="line-height:1.39; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif">General Chairs</span></h3><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Heitor Murilo Gomes, Victoria University of Wellington, New Zealand</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Albert Bifet, Télécom Paris / University of Waikato, France / New Zealand</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Longbing Cao, Macquarie University, Australia</span></span></span></span></span></span></span></li></ul><h3 style="line-height:1.39; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif">Research Track Program Chairs</span></h3><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Philippe Fournier-Viger, Shenzhen University, China</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Yun Sing Koh, University of Auckland, New Zealand</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Jingrui He, University of Illinois at Urbana-Champaign, United States</span></span></span></span></span></span></span></li></ul><h3 style="line-height:1.39; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif">Applied Data Science Track Program Chairs</span></h3><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Slawomir Nowaczyk, Halmstad University, Sweden</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Carlos Soares, University of Porto, Portugal</span></span></span></span></span></span></span></li></ul><h3 style="line-height:1.39; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif">Survey Track Chairs</span></h3><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Jesse Read, École Polytechnique, France </span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Stefan Kramer, Johannes Gutenberg University Mainz, Germany</span></span></span></span></span></span></span></li></ul><h3 style="line-height:1.39; margin-bottom:11px"><span style="font-family:Verdana,Geneva,sans-serif">Special Track on Large Language Models and Agentic AI in Data Science Chairs</span></h3><ul><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Wenbin Zhang, Florida International University, United States</span></span></span></span></span></span></span></li><li style="list-style-type:disc"><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Mahardhika Pratama, Adelaide University, Australia</span></span></span></span></span></span></span></li></ul><p><span style="font-size:14px"><span style="font-family:Verdana,Geneva,sans-serif">Full organising committee: <a href="https://www.pakdd2027.org/pages/organisation/committee" style="text-decoration:none"><span style="font-variant:normal; white-space:pre-wrap"><span style="color:#467886"><span style="font-weight:400"><span style="font-style:normal"><u style="text-decoration:underline"><span style="text-decoration-skip-ink:none">https://www.pakdd2027.org/pages/organisation/committee</span></u></span></span></span></span></a></span></span></p><p><span style="font-family:Verdana,Geneva,sans-serif"><span style="font-size:14px">We look forward to welcoming you to Wellington for PAKDD 2027!</span></span></p></div></div></div></td></tr><tr><td class="footer">Copyright © 2002 – 2026 EasyChair</td></tr></table></body></html>

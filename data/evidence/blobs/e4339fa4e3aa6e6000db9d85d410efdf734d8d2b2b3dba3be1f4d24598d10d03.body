;!-- ICDAR 2027 footer for Hostinger \&quot;Embed code\&quot; element.\n     Two separate groups: IAPR (sponsor) and MyCEB lock-up (supporter).\n     Replace IAPR_LOGO_URL with the link of the IAPR 50th Anniversary logo uploaded to Hostinger. --&gt;\n&lt;style&gt;\n  html, body { margin: 0; padding: 0; background: #ffffff; }\n  .ft {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #ffffff;\n    padding: 20px 12px;\n    display: flex; justify-content: center; align-items: flex-start;\n    flex-wrap: wrap; gap: 28px 56px;\n  }\n  .grp { text-align: center; }\n  .grp p { margin: 0 0 14px; font-size: 15px; color: #555; }\n  .logos {\n    display: flex; justify-content: center; align-items: center;\n    flex-wrap: wrap; gap: 24px 40px; min-height: 84px;\n  }\n  .logos a { display: inline-flex; line-height: 0; }\n  .logos img { height: 64px; width: auto; max-width: 100%; }\n  .logos img.vmy { height: 84px; }  /* larger: this file has extra empty space around it */\n  .divider { width: 1px; align-self: stretch; background: #e3e6ea; }\n  @media (max-width: 700px) {\n    .divider { display: none; }\n    .logos { gap: 16px 24px; min-height: 0; }\n    .logos img { height: 46px; }\n    .logos img.vmy { height: 60px; }\n  }\n&lt;/style&gt;\n\n&lt;div class=\&quot;ft\&quot;&gt;\n  &lt;div class=\&quot;grp\&quot;&gt;\n    &lt;p&gt;Sponsored by:&lt;/p&gt;\n    &lt;div class=\&quot;logos\&quot;&gt;\n      &lt;a href=\&quot;https://iapr.org\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;\n        &lt;img src=\&quot;https://assets.zyrosite.com/luOOjU0j2d2uByyM/50th-logo-png-72-color-1rmtkGuUiWs5KR4n.png\&quot; alt=\&quot;International Association for Pattern Recognition (IAPR)\&quot;&gt;\n      &lt;/a&gt;\n    &lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;div class=\&quot;divider\&quot;&gt;&lt;/div&gt;\n\n  &lt;div class=\&quot;grp\&quot;&gt;\n    &lt;p&gt;Supported by:&lt;/p&gt;\n    &lt;div class=\&quot;logos\&quot;&gt;\n      &lt;a href=\&quot;https://www
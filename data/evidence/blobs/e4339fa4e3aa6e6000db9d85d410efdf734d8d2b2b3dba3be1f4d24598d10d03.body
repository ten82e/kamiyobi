data-pagefind-meta="title[data-pf-title]" data-pf-title="Important dates"><!--[--><section id="ai-TvNem0" class="block block--desktop-first-visible block--mobile-first-visible" style="--block-padding-top:16px;--block-padding:16px 0 16px 0;--block-padding-right:0;--block-padding-bottom:16px;--block-padding-left:0;--m-block-padding:16px;" data-v-6686dd9a><div class="block-background block-background--fixed" data-v-6686dd9a style="--v4cfc8878:#ffffff;--v5abb0200:85%;--v5c6fda9f:85%;--v47c095f9:15%;--v000e51f2:center;--v79d8fbfe:calc(-20svh * 50 / 100);--v3f9ca25a:false;"><!----><!----><!----></div><div class="block-layout block-layout--layout" style="--m-grid-template-rows:11.11vw auto 3.89vw auto 11.39vw auto 23.89vw auto 4.44vw auto 4.72vw auto 0px;--t-grid-template-rows:minmax(40px, auto) minmax(42px, auto) minmax(14px, auto) minmax(376px, auto) minmax(41px, auto) minmax(264px, auto) minmax(86px, auto) minmax(264px, auto) minmax(16px, auto) minmax(26px, auto) minmax(17px, auto) minmax(72px, auto) 1fr;--small-desktop-grid-template-rows:minmax(6.54vw, auto) minmax(5.07vw, auto) minmax(1.47vw, auto) minmax(26.80vw, auto) minmax(7.84vw, auto) minmax(19.61vw, auto) minmax(2.78vw, auto) minmax(1.80vw, auto) minmax(3.92vw, auto) minmax(1.31vw, auto) minmax(6.54vw, auto) minmax(29.41vw, auto) 7.35vw;--grid-template-rows:minmax(80px, auto) minmax(62px, auto) minmax(18px, auto) minmax(328px, auto) minmax(96px, auto) minmax(240px, auto) minmax(34px, auto) minmax(22px, auto) minmax(48px, auto) minmax(16px, auto) minmax(80px, auto) minmax(360px, auto) 1fr;--m-grid-template-columns:100.00%;--grid-template-columns:38.97% 10.54% 9.40% 41.09%;--m-block-min-height:auto;--t-block-min-height:1127px;--small-desktop-block-min-height:auto;--block-min-height:1474px;--v3f3138e2:1224px;--c27f45b8:360px;--v66d5c4a6:0 4.444444444444445vw;--v1984096a:0 16px;" data-v-6686dd9a><!--[--><!--[--><div class="layout-element layout-element--layout layout-element transition transition--slide" style="--text:left;--align:flex-start;--justify:flex-start;--m-element-margin:0 0 16px 0;--z-index:1;--grid-row:2/3;--grid-column:1/5;--m-grid-row:2/3;--m-grid-column:1/2;--v72f86ff9:62px;--v4c707db6:42px;" data-v-5636d6b6><!--[--><!----><!----><!----><!----><!----><div class="text-box layout-element__component layout-element__component--GridTextBox" id="ai-xf1qNP" data-v-5636d6b6 style="--v2b806092:break-spaces;--v12d9d480:initial;--d294b058:break-spaces;"><h3 dir="auto">Important Dates(AOE)</h3></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><div class="layout-element layout-element--layout layout-element transition transition--slide" style="--text:left;--align:flex-start;--justify:flex-start;--m-element-margin:0 0 16px 0;--z-index:2;--grid-row:4/5;--grid-column:1/2;--m-grid-row:4/5;--m-grid-column:1/2;--v72f86ff9:328px;--v4c707db6:376px;" data-v-5636d6b6><!--[--><!----><!----><!----><!----><!----><div class="text-box layout-element__component layout-element__component--GridTextBox" id="ai-ZJ0ako" data-v-5636d6b6 style="--v2b806092:break-spaces;--v12d9d480:initial;--d294b058:break-spaces;"><p dir="auto" class="body" style="margin-bottom: 8px;"><strong><em>Main Paper Deadlines for ICDAR 2027</em></strong></p><ul dir="auto"><li><p dir="auto" class="body"><strong>Abstracts Deadline: </strong>February 26, 2027</p></li><li><p dir="auto" class="body"><strong>Full Paper Deadline:</strong> March 5, 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Reviews to Authors:</strong> April 20, 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Rebuttal Deadline:</strong> April 27, 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Acceptance Notification:</strong> May 15, 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Camera-ready Deadline:</strong> June 5, 2027</p><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"></p></li></ul><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal; margin-bottom: 8px;"><strong><em>IJDAR Journal Track Deadlines for ICDAR 2027</em></strong></p><ul dir="auto"><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Full Paper Deadline:</strong> 15 November 2026</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Initial Track Decision:</strong> 15 January 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Revised version Deadline:</strong> 1 April 2027</p></li><li style="color: rgb(34, 34, 34);"><p dir="auto" class="body" style="color: rgb(34, 34, 34); letter-spacing: normal;"><strong>Final Journal Track Decision:</strong> 15 May 2027</p></li></ul></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><div class="layout-element layout-element--layout layout-element transition transition--slide transition--root-hidden" style="--align:center;--justify:center;--m-element-margin:0 0 16px 0;--z-index:3;--grid-row:6/11;--grid-column:1/3;--m-grid-row:6/7;--m-grid-column:1/2;--v72f86ff9:360px;--v4c707db6:264px;" data-v-5636d6b6><!--[--><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div id="ai-rZR-zM" class="image-wrapper image-wrapper--layout layout-element__component layout-element__component--GridImage" data-v-5636d6b6 style="--v47470dc6:360px;--v6aead284:264px;" data-v-b0a80c2e><div rel="nofollow" title
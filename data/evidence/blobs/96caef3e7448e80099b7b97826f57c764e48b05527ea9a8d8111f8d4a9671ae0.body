    <section id="rQXqAd4dlOPj_rQXqAd4dlOPj" class="brz-section brz-css-d-ynf0il brz-css-1ajd2wo"><div class="brz-section__content brz-section--boxed brz-css-d-oh3bvl brz-css-16qh085" data-brz-custom-id="v3K9paI92lMd"><div class="brz-container brz-css-d-x9rvyp brz-css-fywmng"><div id="" class="brz-css-d-1wonu5h brz-css-1t6rotp brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1s6jml4" data-brz-custom-id="f_kOYo3RJ09Y"><div data-brz-translate-text="1"><h1 class="brz-tp-lg-heading1 brz-text-lg-center brz-bcp-color7 brz-css-1rn6pw1" data-generated-css="brz-css-w59qn" data-uniq-id="mmDdu"><span class="brz-css-19qrh8x">Organising Team</span></h1></div></div></div><div class="brz-row__container brz-css-d-w3a52u brz-css-1ssf1pf" data-brz-custom-id="eJMnWaTnCxdB"><div class="brz-row brz-css-d-1n95ksq brz-css-r-1xc399q brz-css-1gbo71c"><div class="brz-columns brz-css-d-j7y22h brz-css-pn9fku" data-brz-custom-id="oE8aVnRJJzg7"><div class="brz-column__items brz-css-d-v5w42e brz-css-1llc7wu"><div id="" class="brz-css-d-1wonu5h brz-css-10t47kg brz-wrapper"><div class="brz-image brz-css-d-cp3xwo brz-css-1x1ks8v" data-brz-custom-id="mJkh1O7eLO95"><picture class="brz-picture brz-d-block brz-p-relative brz-css-d-1e0v22a brz-css-gk6tlc"><source srcset="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=263&amp;oX=0&amp;oY=9&amp;cW=263&amp;cH=244/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=526&amp;iH=526&amp;oX=0&amp;oY=18&amp;cW=526&amp;cH=488/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 2x" media="(min-width: 992px)"><source srcset="https://cloud-1de12d.becdn.net/media/iW=162&amp;iH=162&amp;oX=0&amp;oY=6&amp;cW=162&amp;cH=151/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=324&amp;iH=324&amp;oX=0&amp;oY=12&amp;cW=324&amp;cH=302/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 2x" media="(min-width: 768px)"><img class="brz-img" srcset="https://cloud-1de12d.becdn.net/media/iW=370&amp;iH=370&amp;oX=0&amp;oY=74&amp;cW=370&amp;cH=222/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=740&amp;iH=740&amp;oX=0&amp;oY=148&amp;cW=740&amp;cH=444/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg 2x" src="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=263&amp;oX=0&amp;oY=9&amp;cW=263&amp;cH=244/2b3ab4046ffaccc014f1bfa8f0a9b6d8/Haiming-Liu.jpg" loading="lazy" alt="" title="Haiming-Liu.jpg" draggable="false"></picture></div></div><div id="" class="brz-css-d-1wonu5h brz-css-bb9tyi brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1sfljnm" data-brz-custom-id="iRrOCKoXGYib"><div data-brz-translate-text="1"><p class="brz-mt-sm-0 brz-mt-xs-0 brz-mt-lg-10 brz-text-lg-center brz-tp-lg-empty brz-ff-jost brz-ft-google brz-fs-lg-20 brz-fss-lg-px brz-fw-lg-500 brz-ls-lg-0 brz-lh-lg-1_5 brz-vfw-lg-400 brz-fwdth-lg-100 brz-fsft-lg-0 brz-css-14ffpt3" data-generated-css="brz-css-ioGBk" data-uniq-id="rTVA3"><a class="link--external brz-cp-color1 brz-bold-true brz-css-s6vyob" href="https://www.southampton.ac.uk/people/5zdhsj/doctor-haiming-liu?page=0" data-brz-link-type="external"><strong>Haiming Liu</strong></a></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-3ll32t brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-o2lefh" data-brz-custom-id="hdYZ1ZVQHOKO"><div data-brz-translate-text="1"><p class="brz-tp-lg-subtitle brz-text-lg-center brz-css-2yc4lt" data-generated-css="brz-css-qqQMd" data-uniq-id="mvGge"><strong class="brz-cp-color1 brz-css-1fl1raa">University of Southampton</strong></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-3sckkt brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-wi12ky" data-brz-custom-id="cMtRLjOAfG3I"><div data-brz-translate-text="1"><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="w_bP4" data-generated-css="brz-css-rRFFT"><strong class="brz-cp-color1 brz-css-1fl1raa"> </strong></p><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="w_bP4" data-generated-css="brz-css-rRFFT"><strong class="brz-cp-color1 brz-css-1fl1raa">Background:</strong><span class="brz-cp-color1 brz-css-1fl1raa"> Dr Haiming Liu is an Associate Professor at School of Electronics and Computer Science (ECS) of University of Southampton (UoS).</span></p><p data-uniq-id="tDiOE" data-generated-css="brz-css-eiTfc" class="brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-tp-lg-paragraph brz-bcp-color1 brz-css-1wkli4b"><span class="brz-cp-color1 brz-css-1fl1raa"> </span></p><p data-uniq-id="tDiOE" data-generated-css="brz-css-eiTfc" class="brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-tp-lg-paragraph brz-bcp-color1 brz-css-1wkli4b"><span class="brz-cp-color1 brz-css-1fl1raa">Haiming joined ECS in May 2022 after 12 years of academic career at various UK institutions. She completed her PhD on User-Centred Interactive Content Based Image Retrieval (CBIR) in 2010 at Knowledge Media Institute (KMi), The Open University.</span></p><p class="brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-tp-lg-paragraph brz-css-1wkli4b" data-uniq-id="pUEJ_" data-generated-css="brz-css-jS9fq"><span class="brz-cp-color1 brz-css-1fl1raa"> </span></p><p class="brz-tp-lg-paragraph brz-css-1wkli4b" data-uniq-id="wLxRe" data-generated-css="brz-css-tZtqg"><br></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-hl6bur" data-brz-custom-id="yw6IZYWqJdNE"><div class="brz-column__items brz-css-d-v5w42e brz-css-a1l9gh"><div id="" class="brz-css-d-1wonu5h brz-css-qdcgpz brz-wrapper"><div class="brz-image brz-css-d-1he8w2d brz-css-145hz95" data-brz-custom-id="oIdyj3wDd6ZM"><picture class="brz-picture brz-d-block brz-p-relative brz-css-d-106nzsj brz-css-o7lmxx"><source srcset="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=328&amp;oX=0&amp;oY=0&amp;cW=263&amp;cH=243/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=526&amp;iH=656&amp;oX=0&amp;oY=0&amp;cW=526&amp;cH=486/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 2x" media="(min-width: 992px)"><source srcset="https://cloud-1de12d.becdn.net/media/iW=162&amp;iH=203&amp;oX=0&amp;oY=0&amp;cW=162&amp;cH=150/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=324&amp;iH=406&amp;oX=0&amp;oY=0&amp;cW=324&amp;cH=300/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 2x" media="(min-width: 768px)"><img class="brz-img" srcset="https://cloud-1de12d.becdn.net/media/iW=370&amp;iH=463&amp;oX=0&amp;oY=23&amp;cW=370&amp;cH=278/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=740&amp;iH=926&amp;oX=0&amp;oY=46&amp;cW=740&amp;cH=556/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg 2x" src="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=328&amp;oX=0&amp;oY=0&amp;cW=263&amp;cH=243/6721538c19b991d7f0d357160ffcd6c8/Frank.jpg" loading="lazy" alt="" title="Frank.jpg" draggable="false"></picture></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1i4lbop brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-16mst3g" data-brz-custom-id="xEc9zFBZzJcg"><div data-brz-translate-text="1"><p class="brz-mt-sm-0 brz-mt-xs-0 brz-mt-lg-10 brz-text-lg-center brz-tp-lg-empty brz-ff-jost brz-ft-google brz-fs-lg-20 brz-fss-lg-px brz-fw-lg-500 brz-ls-lg-0 brz-lh-lg-1_5 brz-vfw-lg-400 brz-fwdth-lg-100 brz-fsft-lg-0 brz-css-14ffpt3" data-generated-css="brz-css-ira72" data-uniq-id="tbz81"><a class="link--external brz-cp-color1 brz-bold-true brz-css-1fl1raa" href="https://www.uni-koblenz.de/de/informatik/west/team/professors/frank-hopfgartner" data-brz-link-type="external" target="_blank" rel="noreferrer noopener"><strong>Frank&nbsp;Hopfgartner</strong></a></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-n063po brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1hppdaa" data-brz-custom-id="jlkUqTWVn6iV"><div data-brz-translate-text="1"><p class="brz-tp-lg-subtitle brz-text-lg-center brz-css-2yc4lt" data-generated-css="brz-css-u839B" data-uniq-id="towff"><strong class="brz-cp-color1 brz-css-1fl1raa">Universität Koblenz</strong></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1srnjza brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1opal6u" data-brz-custom-id="gaGSpQuuA__D"><div data-brz-translate-text="1"><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="hEENb" data-generated-css="brz-css-k8Bzg"><strong class="brz-cp-color1 brz-css-1fl1raa"> </strong></p><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="hEENb" data-generated-css="brz-css-k8Bzg"><strong class="brz-cp-color1 brz-css-1fl1raa">Background: </strong><span class="brz-cp-color1 brz-css-1fl1raa">Professor for Data Science at Universität Koblenz and Visiting Professor at the University of Sheffield. In Koblenz, Frank leads the Institute for Web Science &amp; Technologies&nbsp;and coordinate the MSc in Web and Data Science&nbsp;and BSc in Computational Social Science&nbsp;programmes.</span></p><p class="brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-tp-lg-paragraph brz-css-1wkli4b" data-uniq-id="kIZwf" data-generated-css="brz-css-aYbek"><span class="brz-cp-color1 brz-css-1fl1raa"> </span></p><p class="brz-tp-lg-paragraph brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-bcp-color1 brz-css-1wkli4b" data-uniq-id="lL8MY" data-generated-css="brz-css-bKvxE"><span class="brz-cp-color1 brz-css-1fl1raa">Frank's main research interest is in the intersection of&nbsp;human-centred and responsible&nbsp;artificial intelligence&nbsp;and&nbsp;data science.</span></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-9d6to2" data-brz-custom-id="nKjKiQftXd83"><div class="brz-column__items brz-css-d-v5w42e brz-css-1w9w2d0"><div id="" class="brz-css-d-1wonu5h brz-css-yt0wsx brz-wrapper"><div class="brz-image brz-css-d-t4k9i7 brz-css-15curyl" data-brz-custom-id="w5cvPlQgoXXW"><picture class="brz-picture brz-d-block brz-p-relative brz-css-d-atmdum brz-css-1rxew0n"><source srcset="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=341&amp;oX=0&amp;oY=15&amp;cW=263&amp;cH=242/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=526&amp;iH=682&amp;oX=0&amp;oY=30&amp;cW=526&amp;cH=484/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 2x" media="(min-width: 992px)"><source srcset="https://cloud-1de12d.becdn.net/media/iW=162&amp;iH=210&amp;oX=0&amp;oY=9&amp;cW=162&amp;cH=149/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=324&amp;iH=420&amp;oX=0&amp;oY=18&amp;cW=324&amp;cH=298/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 2x" media="(min-width: 768px)"><img class="brz-img" srcset="https://cloud-1de12d.becdn.net/media/iW=370&amp;iH=480&amp;oX=0&amp;oY=48&amp;cW=370&amp;cH=288/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=740&amp;iH=960&amp;oX=0&amp;oY=96&amp;cW=740&amp;cH=576/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg 2x" src="https://cloud-1de12d.becdn.net/media/iW=263&amp;iH=341&amp;oX=0&amp;oY=15&amp;cW=263&amp;cH=242/8a9e401c5c8fe209138f6b9287732f4e/Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg" loading="lazy" alt="" title="Dame-Wendy-Hall-Headshot-resize-2-png-SIA-JPG-fit-to-width-INLINE.jpg" draggable="false"></picture></div></div><div id="" class="brz-css-d-1wonu5h brz-css-92rrhj brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-qjf6ko" data-brz-custom-id="tmJrribKSpWG"><div data-brz-translate-text="1"><p class="brz-text-lg-center brz-mt-lg-10 brz-mt-xs-0 brz-mt-sm-0 brz-fss-lg-px brz-fw-lg-500 brz-ls-lg-m_1_3 brz-lh-lg-1_5 brz-vfw-lg-400 brz-fwdth-lg-100 brz-fsft-lg-0 brz-tp-lg-empty brz-ff-jost brz-ft-google brz-fs-lg-20 brz-css-1u5nkwy" data-uniq-id="xFlj3" data-generated-css="brz-css-eJVtX"><strong class="brz-cp-color2 brz-bold-true brz-css-n9jwpg">Dame Wendy Hall (Honorary)</strong></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-fbfzql brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-13dt7yu" data-brz-custom-id="aY86D25Po6Eb"><div data-brz-translate-text="1"><p class="brz-tp-lg-subtitle brz-text-lg-center brz-css-2yc4lt" data-generated-css="brz-css-eG8xJ" data-uniq-id="izRCg"><strong class="brz-cp-color1 brz-css-1fl1raa">University of Southampton</strong></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1bt79ng brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1j5pjne" data-brz-custom-id="ezfAMyG68tG_"><div data-brz-translate-text="1"><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="okS9F" data-generated-css="brz-css-rEZEk"><strong class="brz-cp-color1 brz-css-1fl1raa"> </strong></p><p class="brz-tp-lg-paragraph brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-css-1wkli4b" data-uniq-id="okS9F" data-generated-css="brz-css-rEZEk"><strong class="brz-cp-color1 brz-css-1fl1raa">Background:</strong><span class="brz-cp-color1 brz-css-1fl1raa"> Regius Professor of Computer Science, Associate Vice President (International Engagement), and Executive Director of the Web Science Institute at the University of Southampton.</span></p><p class="brz-bcp-color8 brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-tp-lg-paragraph brz-css-1wkli4b" data-uniq-id="zoBOl" data-generated-css="brz-css-bmtGP"><span class="brz-cp-color1 brz-css-1fl1raa"> </span></p><p class="brz-tp-lg-paragraph brz-lh-lg-1_6 brz-ls-lg-0 brz-fw-lg-300 brz-fss-lg-px brz-fs-lg-18 brz-ft-google brz-ff-roboto brz-bcp-color1 brz-css-1wkli4b" data-uniq-id="qsmH7" data-generated-css="brz-css-benXu"><span class="brz-cp-color1 brz-css-1fl1raa">Many of Wendy’s previous roles include: President of the ACM, President of BCS, Senior Vice President of the Royal Academy of Engineering, a member of the UK Prime Minister’s Council for Science and Technology, founding member of the European Research Council, to name a few.</span></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-o4wml9" data-brz-custom-id="fObuKXMEEn1i"><div class="brz-column__items brz-css-d-v5w42e brz-css-qejx9l"><div id="" class="brz-css-d-1wonu5h brz-css-9jtcwj brz-wrapper"><div class="brz-image brz-css-d-ir8uvs brz-css-tz8kpe" data-brz-custom-id="u35gTtKR4gN4"><picture class="brz-picture brz-d-block brz-p-relative brz-css-d-bv6kvj brz-css-sev95t"><source srcset="https://cloud-1de12d.becdn.net/media/iW=362&amp;iH=241&amp;oX=25&amp;oY=0&amp;cW=263&amp;cH=241/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=724&amp;iH=482&amp;oX=50&amp;oY=0&amp;cW=526&amp;cH=482/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 2x" media="(min-width: 992px)"><source srcset="https://cloud-1de12d.becdn.net/media/iW=224&amp;iH=149&amp;oX=15&amp;oY=0&amp;cW=162&amp;cH=149/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=448&amp;iH=298&amp;oX=30&amp;oY=0&amp;cW=324&amp;cH=298/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 2x" media="(min-width: 768px)"><img class="brz-img" srcset="https://cloud-1de12d.becdn.net/media/iW=370&amp;iH=246&amp;oX=0&amp;oY=17&amp;cW=370&amp;cH=148/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=740&amp;iH=492&amp;oX=0&amp;oY=34&amp;cW=740&amp;cH=296/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg 2x" src="https://cloud-1de12d.becdn.net/media/iW=362&amp;iH=241&amp;oX=25&amp;oY=0&amp;cW=263&amp;cH=241/be9c1970aaa4a1ba8a13c38190db45c7/CPD-Individual-Photo-Julie-small.jpg" loading="lazy" alt="" title="CPD-Individual-Photo-Julie-small.jpg" draggable="false"></picture></div></div><div id="" class="brz-css-d-1wonu5h brz-css-n32mn3 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1eah5nl" data-brz-custom-id="x7EbXZFKUeiA"><div data-brz-translate-text="1"><p class="brz-mt-lg-10 brz-mt-xs-0 brz-mt-sm-0 brz-text-lg-center brz-tp-lg-empty brz-ff-jost brz-ft-google brz-fs-lg-20 brz-fss-lg-px brz-fw-lg-500 brz-ls-lg-0 brz-lh-lg-1_5 brz-vfw-lg-400 brz-fwdth-lg-100 brz-fsft-lg-0 brz-css-14ffpt3" data-uniq-id="w8ZUA" data-generated-css="brz-css-jd9ej"><a class="link--external brz-cp-color2 brz-bold-true brz-css-n9jwpg" href="https://www.abdn.ac.uk/people/j.dixon" data-brz-link-type="external" target="_blank" rel="noreferrer noopener"><strong>Julie Dixon</strong></a></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1pgxuac brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1egc5iu" data-brz-custom-id="nMsfe9EzD1f6"><div data-brz-translate-text="1"><p class="brz-tp-lg-subtitle brz-text-lg-center brz-css-2yc4lt" data-uniq-id="ryCDW" data-generated-css="brz-css-jU0vF"><strong class="brz-cp-color1 brz-css-1fl1raa">University of Aberdeen</strong></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-y6w9b5 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-k2eidz" data-brz-custom-id="ljClpK1Hr8Pu"><div data-brz-translate-text="1"><p class="brz-ff-roboto brz-ft-google brz-fs-lg-18 brz-fss-lg-px brz-fw-lg-300 brz-ls-lg-0 brz-lh-lg-1_6 brz-bcp-color8 brz-tp-lg-paragraph brz-css-1wkli4b" data-generated-css="brz-css-pyPb4" data-uniq-id="lxQDN"><strong class="brz-cp-color1 brz-css-1fl1raa"> </strong></p><p class="brz-ff-roboto brz-ft-google brz-fs-lg-18 brz-fss-lg-px brz-fw-lg-300 brz-ls-lg-0 brz-lh-lg-1_6 brz-bcp-color8 brz-tp-lg-paragraph brz-css-1wkli4b" data-generated-css="brz-css-pyPb4" data-uniq-id="lxQDN"><strong class="brz-cp-color1 brz-css-1fl1raa">Background: </strong><span class="brz-cp-color1 brz-css-1fl1raa">Julie joined the University of Aberdeen in 2006 as a CPD Business Development Officer within the Research &amp; Innovation Directorate.</span></p><p class="brz-ff-roboto brz-ft-google brz-fs-lg-18 brz-fss-lg-px brz-fw-lg-300 brz-ls-lg-0 brz-lh-lg-1_6 brz-bcp-color8 brz-tp-lg-paragraph brz-css-1wkli4b" data-generated-css="brz-css-mSN9h" data-uniq-id="bLAgE"><br></p><p data-generated-css="brz-css-gge30" data-uniq-id="ml8wB" class="brz-ff-roboto brz-ft-google brz-fs-lg-18 brz-fss-lg-px brz-fw-lg-300 brz-ls-lg-0 brz-lh-lg-1_6 brz-tp-lg-paragraph brz-bcp-color8 brz-css-1wkli4b"><span class="brz-cp-color1 brz-css-1fl1raa">Julie has much experience of event development, organisation, management and delivery, and was involved in hosting ECIR 2017 at the AECC in Aberdeen with Robert Gordon University.</span></p><p class="brz-bcp-color1 brz-ff-roboto brz-ft-google brz-fs-lg-18 brz-fss-lg-px brz-fw-lg-300 brz-ls-lg-0 brz-lh-lg-1_6 brz-tp-lg-paragraph brz-css-1wkli4b" data-generated-css="brz-css-fO24Z" data-uniq-id="sFjdT"><br></p></div></div></div></div></div></div></div></div></div></section>

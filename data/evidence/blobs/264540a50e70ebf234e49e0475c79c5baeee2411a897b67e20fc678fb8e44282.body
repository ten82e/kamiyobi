    		<div class="elementor-element elementor-element-d1b6f9c elementor-widget__width-initial elementor-widget elementor-widget-html" data-id="d1b6f9c" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<style>
.elementor-element-dd91c6e {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  padding-right: 0 !important;
  padding-left: 0 !important;
  background-color: #0D3B4F;
}
.umap-hero {
  position: relative;
  width: auto;
  margin-inline: calc(50% - 50vw);
  left: auto;
  right: auto;
  margin-top: 0px;
  height: 550px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background-color: #0D3B4F;
}
.umap-hero-slide {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background-size: cover;
  background-position: center;
  opacity: 0;
  animation: umapFade 24s infinite;
  animation-fill-mode: both;
}
.umap-hero-slide:nth-child(1) { background-image: url('https://um.org/umap2027/wp-content/uploads/2026/08/clean-daytimefixed-scaled.jpeg'); animation-delay: 0s; opacity: 1; background-position: center right; }
.umap-hero-slide:nth-child(2) { background-image: url('https://um.org/umap2027/wp-content/uploads/2026/09/chicago_tops1.jpg'); animation-delay: 6s; 
    background-position: top center;
}
.umap-hero-slide:nth-child(3) { background-image: url('https://um.org/umap2027/wp-content/uploads/2026/08/chicago_river_night.jpg'); animation-delay: 12s; }
.umap-hero-slide:nth-child(4) { background-image: url('https://um.org/umap2027/wp-content/uploads/2026/09/chicago_bean3.jpg'); animation-delay: 18s; 
    background-position: center; 
}
@keyframes umapFade {
  0% { opacity: 0; }
  4% { opacity: 1; }
  25% { opacity: 1; }
  29% { opacity: 0; }
  100% { opacity: 0; }
}
.umap-hero-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.35);
  z-index: 1;
}
.umap-hero-content {
  position: relative;
  z-index: 2;
  color: #ffffff;
  padding: 0 60px;
  max-width: 900px;
}
.umap-hero-content h1 {
  font-size: 40px;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
  color: #ffffff !important;
  text-shadow: 0 2px 8px rgba(0,0,0,0.4);
}
.umap-infobar {
  display: flex;
  width: auto;
  flex-wrap: wrap;
  align-items: stretch;
}
.umap-infobar-left {
  background: #0D3B4F;
  color: #ffffff;
  flex: 3 1 0;
  padding: 30px 40px;
  text-align: center;
  box-sizing: border-box;
}
.umap-infobar-left h3 {
  margin: 0 0 8px 0;
  font-size: 34px;
  font-weight: 700;
  color: #ffffff !important;
}
.umap-infobar-left p {
  margin: 0;
  font-size: 22px;
  color: #ffffff !important;
}
.umap-infobar-right {
  background: #F2A71B;
  color: #ffffff;
  flex: 2 1 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 60px;
  padding: 20px;
  box-sizing: border-box;
  align-self: stretch;
}
.umap-countdown-item {
  text-align: center;
}
.umap-countdown-number {
  font-size: 42px;
  font-weight: 800;
  line-height: 1;
  color: #ffffff !important;
}
.umap-countdown-label {
  font-size: 14px;
  margin-top: 4px;
  color: #ffffff !important;
}
@media (max-width: 782px) {
  .umap-infobar { flex-direction: column; }
}
</style>

<div class="umap-hero">
  <div class="umap-hero-slide"></div>
  <div class="umap-hero-slide"></div>
  <div class="umap-hero-slide"></div>
  <div class="umap-hero-slide"></div>
  <div class="umap-hero-overlay"></div>
  <div class="umap-hero-content">
    <h1>The 35th ACM International Conference on User Modeling, Adaptation and Personalization (ACM UMAP 2027)</h1>
  </div>
</div>

<div class="umap-infobar">
  <div class="umap-infobar-left">
    <h3>Chicago, USA</h3>
    <p>June 9 &mdash; 12, 2027</p>
    (Doctoral Consortium on June 8)
  </div>
  <div class="umap-infobar-right">
    <div class="umap-countdown-item">
      <div class="umap-countdown-number" id="umap-days">--</div>
      <div class="umap-countdown-label">Days</div>
    </div>
    <div class="umap-countdown-item">
      <div class="umap-countdown-number" id="umap-hours">--</div>
      <div class="umap-countdown-label">Hours</div>
    </div>
    <div class="umap-countdown-item">
      <div class="umap-countdown-number" id="umap-minutes">--</div>
      <div class="umap-countdown-label">Minutes</div>
    </div>
  </div>
</div>

<script>
function umapUpdateCountdown() {
  var target = new Date('2027-06-09T00:00:00');
  var now = new Date();
  var diff = target - now;
  if (diff < 0) diff = 0;
  var days = Math.floor(diff / (1000*60*60*24));
  var hours = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
  var minutes = Math.floor((diff % (1000*60*60)) / (1000*60));
  document.getElementById('umap-days').textContent = days;
  document.getElementById('umap-hours').textContent = hours;
  document.getElementById('umap-minutes').textContent = minutes;
}
umapUpdateCountdown();
setInterval(umapUpdateCountdown, 60000);
</script>				</div>
		
</div>
<div class="elementor-element elementor-element-825c617 e-con e-atomic-element e-flexbox-base " data-id="825c617" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="825c617">
    			<h2 data-interaction-id="8a0ca10" class="e-heading-base"></h2>
		
</div>
<div class="elementor-element elementor-element-1e01ba3 e-con e-atomic-element e-flexbox-base e-1d5fafa " data-id="1e01ba3" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="1e01ba3">
    		<div class="elementor-element elementor-element-8ddd024 elementor-widget__width-initial elementor-widget elementor-widget-text-editor" data-id="8ddd024" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>ACM UMAP is the premier international conference bringing together research in AI and HCI to support effective human-AI collaboration via interactive </p><p><span style="font-style: inherit; font-weight: inherit;">systems that can model, adapt and personalize to their users. UMAP is now a ranked A (“Excellent”) conference in the <a href="https://portal.core.edu.au/conf-ranks/1259/" target="_blank" rel="noopener">ICore 2026 rankings.</a> </span></p><p><span style="font-style: inherit; font-weight: inherit;">The conference is sponsored by <a href="https://sigchi.org/" target="_blank" rel="noopener">ACM SIGCHI</a> and <a href="https://www.sigweb.org/" target="_blank" rel="noopener">ACM SIGWEB</a>. <a href="https://um.org/">User Modeling Inc.</a>, </span><span style="font-style: inherit; font-weight: inherit;">as the core Steering Committee, oversees the conference organization. </span></p><p><span style="font-style: inherit; font-weight: inherit;">UMAP operates under the <a href="https://www.acm.org/about-acm/policy-against-harassment" target="_blank" rel="noopener">ACM Conference Code of Conduct</a>.</span></p>								</div>
		
</div>
<div class="elementor-element elementor-element-5ceb941 e-con e-atomic-element e-flexbox-base e-9f4fcf3 " data-id="5ceb941" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="5ceb941">
    		<div class="elementor-element elementor-element-14b65fa elementor-widget elementor-widget-text-editor" data-id="14b65fa" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p><b>UMAP 2027 is scheduled as an in-person conference taking place in Chicago, USA on June 9-12, 2027. </b></p><p><b>Please check our attendance and registration <a href="https://um.org/umap2027/registration/" target="_blank" rel="noopener">policy </a></b><b>in case of severe travel restrictions or cancellations.</b></p>								</div>
		
</div>
<div class="elementor-element elementor-element-bc17a8c e-con e-atomic-element e-flexbox-base e-a13ff88 " data-id="bc17a8c" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="bc17a8c">
    <div class="elementor-element elementor-element-1d032d1 e-con e-atomic-element e-flexbox-base e-5e34947 " data-id="1d032d1" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="1d032d1">
    		<div class="elementor-element elementor-element-55bcd10 elementor-widget elementor-widget-html" data-id="55bcd10" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">

.umap-schedule-wrapper {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 40px;
  box-sizing: border-box;
}
.umap-schedule-heading {
  color: #F2A71B;
  font-weight: 700;
  font-size: 28px;
  margin: 0 0 8px 0;   /* 原来是 margin-bottom: 24px */
}
.umap-schedule-note {
  color: #333;
  font-size: 15px;
  line-height: 1.6;
  margin: 0 0 28px 0;  /* 上边距归零，下边距留给卡片 */
}
.umap-schedule-note a {
  color: #0D3B4F;
  text-decoration: underline;
}

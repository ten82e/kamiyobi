    </div>
    <div class="fine">Computer Engineering Group · Prof. Dr.-Ing. habil. Michael Hübner · from Sept. 1st at Humboldt-Universität zu Berlin</div>
  </div>
</footer>

<script>
  // mobile nav
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('navlinks');
  btn.addEventListener('click', () => nav.classList.toggle('open'));
  nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => nav.classList.remove('open')));

  // reconfigurable fabric hero motif: light up a random sparse subset of cells
  const fabric = document.getElementById('fabric');
  const COLS = 24, ROWS = 10;
  const total = COLS * ROWS;
  const litCount = Math.round(total * 0.09);
  const lit2Count = Math.round(total * 0.06);
  const indices = [...Array(total).keys()];
  for (let i = indices.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [indices[i], indices[j]] = [indices[j], indices[i]];
  }
  const litSet = new Set(indices.slice(0, litCount));
  const lit2Set = new Set(indices.slice(litCount, litCount + lit2Count));
  const frag = document.createDocumentFragment();
  for (let i = 0; i < total; i++) {
    const cell = document.createElement('i');
    if (litSet.has(i)) cell.className = 'lit';
    else if (lit2Set.has(i)) cell.className = 'lit2';
    cell.style.animationDelay = (Math.random() * 5).toFixed(2) + 's';
    frag.appendChild(cell);
  }
  fabric.appendChild(frag);
</script>

</body>
</html>

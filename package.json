{
  "name": "kamiyobi",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "HPC、ネットワーク、システム、AI、セキュリティ会議の締切を JSON/CSV/Pages で配信",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/cli.ts build",
    "discover": "node src/cli.ts discover",
    "generate:curated": "node scripts/generate-curated.ts",
    "bench": "node src/bench-recommender.ts",
    "validate:data": "node scripts/validate-data.ts",
    "health-gate": "node scripts/health-gate.ts public/health.json --report work/health-gate-violations.json --observation-baseline data/source-observation-baseline.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "check": "biome check src scripts site/*.ts tests --files-ignore-unknown=false",
    "format": "biome format --write src tests",
    "update": "npm run validate:data -- public/data.json && npm run health-gate",
    "build:manual": "node src/cli.ts build --out public"
  },
  "license": "MIT",
  "overrides": {
    "adm-zip": "0.6.0",
    "onnxruntime-node": "1.27.0",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "html-entities": "^2.6.0",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
